@import "tailwindcss";
@import "tw-animate-css";
@import "../vendor/shadcn-tailwind-4.13.0.css";
@theme inline { --font-sans: Arial, Helvetica, sans-serif; }
:root{--ink:#24362e;--green:#174b37;--muted:#77817b;--line:#e3e7e1;--bg:#f5f6f3;--radius:12px;color-scheme:light}
