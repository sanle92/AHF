'use client';
import {useCallback,useEffect,useMemo,useRef,useState,type FormEvent,type ReactNode} from 'react';
import {Activity,ArrowDownLeft,ArrowRight,ArrowUpRight,BarChart3,Bell,CalendarDays,Check,CheckCircle2,ChevronDown,ChevronRight,ClipboardList,Download,FileText,FolderOpen,Heart,Home,Leaf,LogOut,Menu,Plus,Search,Settings,ShieldCheck,Sparkles,Users,Wallet,X,WifiOff,LoaderCircle,Clock,RefreshCw} from 'lucide-react';
import {canRead,canWrite,initialStatus,kinds,money,nextStatuses,roleLabels,shortDate,validateRecord,type Kind,type Notice,type Profile,type RecordItem} from '@/lib/domain';
import {demoId,demoProfiles,seedRecords} from '@/lib/demo';
import {organization} from '@/lib/organization';
import {moduleConfig,grouped} from '@/lib/modules';
import {canReadRecord,type ProgrammeMember,type Approval} from '@/lib/domain';
import Reports from './reports';
import RecordForm from './record-form';
import RecordDetail from './record-detail';
import ModuleRecords from './module-records';
import Approvals from './approvals';
import FinanceSummary from './finance-summary';
import DonorSummary from './donor-summary';
import NotificationSettings from './notification-settings';
import OrganizationSetup from './organization-setup';
import MfaGate from './mfa-gate';
import {hasSecondFactor} from '@/lib/assurance';
type Section='Approvals'|'Overview'|'Programs'|'Beneficiaries'|'Donors'|'Finance'|'Secretary'|'Tasks'|'Team'|'Documents'|'Reports'|'Settings';
type Config={mode:'demo'|'live'|'setup';url:string;key:string;vapidPublic:string;pushReady:boolean};
type Session={access_token:string;refresh_token:string;expires_at:number};
const sections:{name:Section;icon:typeof Home;kinds:Kind[];description:string}[]=[
 {name:'Overview',icon:Home,kinds:[],description:'A little clarity. A greater impact.'},
 {name:'Programs',icon:Heart,kinds:grouped('Programs'),description:'Turn your mission into meaningful action.'},
 {name:'Beneficiaries',icon:Users,kinds:['beneficiary'],description:'Coordinate support with care and confidentiality.'},
 {name:'Donors',icon:Heart,kinds:grouped('Donors'),description:'Nurture the relationships that make your work possible.'},
 {name:'Finance',icon:Wallet,kinds:grouped('Finance'),description:'A clear view of every contribution and commitment.'},
 {name:'Secretary',icon:ClipboardList,kinds:grouped('Secretary'),description:'Keep decisions, records, and next steps connected.'},
 {name:'Tasks',icon:CheckCircle2,kinds:['task'],description:'Know what comes next, and who is taking it forward.'},
 {name:'Approvals',icon:ShieldCheck,kinds:[],description:'Review specific requests without opening restricted workspaces.'},
 {name:'Team',icon:Users,kinds:[],description:'The people behind the purpose.'},
 {name:'Documents',icon:FolderOpen,kinds:['document'],description:'Keep your institutional knowledge close at hand.'},
 {name:'Reports',icon:BarChart3,kinds:[],description:'Understand the work. Account for the resources.'},
 {name:'Settings',icon:Settings,kinds:[],description:'Make this workspace work for your team.'},
];
const labels=Object.fromEntries(kinds.map(k=>[k,moduleConfig[k].label])) as Record<Kind,string>;
const singular=Object.fromEntries(kinds.map(k=>[k,moduleConfig[k].singular])) as Record<Kind,string>;
const navFor=(kind:Kind):Section=>kind==='donation'?'Donors':sections.find(s=>s.kinds.includes(kind))?.name||'Overview';
const storageKey='ahf-demo-records-v1';
function Badge({children}:{children:ReactNode}){const s=String(children);return <span className={'badge '+(['Active','Received','Approved','Paid','Completed','Fulfilled'].includes(s)?'green':['Pending','In review','Pledged','Open'].includes(s)?'amber':'gray')}><i/>{children}</span>;}
function Modal({title,onClose,children,wide=false}:{title:string;onClose:()=>void;children:ReactNode;wide?:boolean}){
 const ref=useRef<HTMLDialogElement>(null);useEffect(()=>{const dialog=ref.current;dialog?.showModal();return()=>{dialog?.close();};},[]);
 return <dialog ref={ref} className={'modal '+(wide?'wide':'')} onCancel={onClose} onClick={e=>{if(e.target===e.currentTarget)onClose();}}><div className="modal-head"><h2>{title}</h2><button className="icon-button" onClick={onClose} aria-label="Close dialog"><X size={20}/></button></div>{children}</dialog>;
}
function Stat({label,value,note,icon:Icon}:{label:string;value:string|number;note:string;icon:typeof Home}){return <div className="stat"><div className="stat-label">{label}<Icon size={17}/></div><strong>{value}</strong><span>{note}</span></div>;}
function Empty({message='No records yet. Add the first one to get started.'}:{message?:string}){return <div className="empty"><FolderOpen size={30}/><h3>Room for what comes next</h3><p>{message}</p></div>;}
export default function Workspace(){
 const [config,setConfig]=useState<Config|null>(null),[session,setSession]=useState<Session|null>(null),[profile,setProfile]=useState<Profile|null>(null),[team,setTeam]=useState<Profile[]>([]),[records,setRecords]=useState<RecordItem[]>([]),[notices,setNotices]=useState<Notice[]>([]),[mfaNeeded,setMfaNeeded]=useState(false),[lastSynced,setLastSynced]=useState<string|null>(null);
 const [section,setSection]=useState<Section>('Overview'),[kind,setKind]=useState<Kind>('program'),[search,setSearch]=useState(''),[status,setStatus]=useState('All statuses'),[menu,setMenu]=useState(false),[busy,setBusy]=useState(false),[loading,setLoading]=useState(true),[error,setError]=useState(''),[toast,setToast]=useState(''),[online,setOnline]=useState(true);
 const [editing,setEditing]=useState<RecordItem|null>(null),[createKind,setCreateKind]=useState<Kind|null>(null),[selected,setSelected]=useState<RecordItem|null>(null),[panel,setPanel]=useState<'notifications'|'reset'|null>(null);

 const [members,setMembers]=useState<ProgrammeMember[]>([]),[approvals,setApprovals]=useState<(Approval&{snapshot:Record<string,unknown>})[]>([]);
 const seenNotices=useRef<Set<string>|null>(null),authEpoch=useRef(0);
 const demo=config?.mode==='demo';
 const notify=useCallback((s:string)=>{setToast(s);},[]);
 useEffect(()=>{if(!toast)return;const timer=setTimeout(()=>setToast(''),4500);return()=>clearTimeout(timer);},[toast]);
 useEffect(()=>{setOnline(navigator.onLine);const yes=()=>setOnline(true),no=()=>setOnline(false);window.addEventListener('online',yes);window.addEventListener('offline',no);if('serviceWorker'in navigator)navigator.serviceWorker.register('/sw.js').catch(()=>{});return()=>{window.removeEventListener('online',yes);window.removeEventListener('offline',no);};},[]);
 const api=useCallback(async(path:string,init:RequestInit={})=>{if(!session)throw new Error('Sign in required.');const r=await fetch('/api/'+path,{...init,headers:{Authorization:`Bearer ${session.access_token}`,...(!(init.body instanceof FormData)?{'Content-Type':'application/json'}:{}),...init.headers},cache:'no-store'});const data=await r.json<any>();if(!r.ok)throw Object.assign(new Error(data.error||'The request failed.'),{status:r.status});return data;},[session]);
 useEffect(()=>{fetch('/api/config',{cache:'no-store'}).then(r=>{if(!r.ok)throw new Error('Unable to load workspace configuration.');return r.json<any>();}).then((c:Config)=>{setConfig(c);if(c.mode==='demo'){setProfile(demoProfiles[2]);setTeam(demoProfiles);try{const data=JSON.parse(localStorage.getItem(storageKey)||'null');setRecords(Array.isArray(data)?data:seedRecords());}catch{setRecords(seedRecords());}setLoading(false);}else if(c.mode==='live'){try{setSession(JSON.parse(sessionStorage.getItem('ahf-session')||'null'));}catch{}setLoading(false);}else setLoading(false);}).catch(e=>{setError(e.message);setLoading(false);});},[]);
 const refresh=useCallback(async()=>{const epoch=authEpoch.current;if(!session)return;if(!hasSecondFactor(session.access_token)){setMfaNeeded(true);setLoading(false);return;}setLoading(true);try{const [me,data,notifications,reviews]=await Promise.all([api('session'),api('records'),api('notifications'),api('approvals')]);if(epoch!==authEpoch.current)return;setProfile(me.profile);setTeam(me.team);setMembers(me.members||[]);setRecords(data);setNotices(notifications);setApprovals(reviews);setSelected(current=>current?data.find((r:RecordItem)=>r.id===current.id)||null:null);setLastSynced(new Date().toISOString());setMfaNeeded(false);}catch(e){if(epoch!==authEpoch.current)return;const message=(e as Error).message;if(message==='Two-step verification required.'){setMfaNeeded(true);setProfile(null);setRecords([]);setNotices([]);}else{setError(message);if([401,403].includes((e as Error&{status?:number}).status||0)||/Access denied|Sign in required|not enabled/.test(message)){setProfile(null);setRecords([]);setNotices([]);}}}finally{setLoading(false);}},[api,session]);
 useEffect(()=>{if(config?.mode==='live'&&session)void refresh();},[config?.mode,session,refresh]);
 useEffect(()=>{if(!profile||demo)return;const timer=setInterval(()=>{if(navigator.onLine&&document.visibilityState==='visible')void refresh();},60000);const focus=()=>{if(navigator.onLine)void refresh();};window.addEventListener('focus',focus);return()=>{clearInterval(timer);window.removeEventListener('focus',focus);};},[profile,demo,refresh]);
 useEffect(()=>{if(!session||!config||demo)return;let cancelled=false;const delay=Math.max(1000,(session.expires_at*1000)-Date.now()-60000);const timer=setTimeout(async()=>{try{const r=await fetch(config.url+'/auth/v1/token?grant_type=refresh_token',{method:'POST',headers:{apikey:config.key,'Content-Type':'application/json'},body:JSON.stringify({refresh_token:session.refresh_token})});if(!r.ok)throw new Error('Session expired. Please sign in again.');const v=await r.json<any>();if(cancelled)return;const updated={...v,expires_at:Math.floor(Date.now()/1000)+v.expires_in};sessionStorage.setItem('ahf-session',JSON.stringify(updated));setSession(updated);}catch(e){if(cancelled)return;authEpoch.current++;setSession(null);setProfile(null);sessionStorage.removeItem('ahf-session');setError((e as Error).message);}},delay);return()=>{cancelled=true;clearTimeout(timer);};},[session,config,demo]);
 useEffect(()=>{if(demo&&records.length)try{localStorage.setItem(storageKey,JSON.stringify(records));}catch{setError('Your browser could not save demo changes.');}},[records,demo]);
 const visible=useMemo(()=>profile?records.filter(r=>canReadRecord(profile,r,members)):[],[records,profile,members]);
 const go=(s:Section,k?:Kind)=>{const sec=sections.find(x=>x.name===s);if(profile&&sec?.kinds.length&&!sec.kinds.some(k=>canRead(profile,k)))return;setSection(s);setKind(k||sec?.kinds.find(k=>profile&&canRead(profile,k))||'program');setSearch('');setStatus('All statuses');setMenu(false);};
 const open=(r:RecordItem)=>{setSelected(r);};

 const globalResults=search?visible.filter(r=>[r.title,r.category].join(' ').toLowerCase().includes(search.toLowerCase())).slice(0,8):[];
 const received=visible.filter(r=>r.kind==='donation'&&r.status==='Received'&&(r.currency||'UGX')==='UGX').reduce((a,r)=>a+r.amount,0),paid=visible.filter(r=>r.kind==='payment'&&['Paid','Reconciled'].includes(r.status)&&(r.currency||'UGX')==='UGX').reduce((a,r)=>a+r.amount,0);
 const waiting=visible.filter(r=>(r.kind==='expense'&&r.status==='Submitted')||(r.kind==='minutes'&&r.status==='In review'));
 const pendingTasks=visible.filter(r=>['task','activity','resolution'].includes(r.kind)&&!['Completed','Closed','Cancelled','Verified','Implemented'].includes(r.status));
 const doAction=async(fn:()=>Promise<void>)=>{setBusy(true);setError('');try{await fn();}catch(e){setError((e as Error).message);}finally{setBusy(false);}};
 const changeStatus=(item:RecordItem,target:string,note='')=>doAction(async()=>{if(!profile||!nextStatuses(item,profile).includes(target))throw new Error('This action is not permitted.');let updated:RecordItem;if(demo){updated={...item,status:target,version:item.version+1,updated_at:new Date().toISOString(),details:{...item.details,last_action_by:profile.id}};}else updated=await api('records',{method:'PATCH',body:JSON.stringify({id:item.id,status:target,version:item.version,note})});setRecords(rs=>rs.map(r=>r.id===item.id?updated:r));setSelected(updated);notify('Record updated to '+target.toLowerCase()+'.');if(!demo)await refresh();});
 const saveValue=async(value:ReturnType<typeof validateRecord>)=>{if(!profile||!createKind)return;setBusy(true);try{if(!canWrite(profile,value.kind))throw new Error('Access denied.');let saved:RecordItem;if(demo){saved={id:editing?.id||demoId(),...value,status:editing?.status||initialStatus(value.kind),created_by:editing?.created_by||profile.id,created_at:editing?.created_at||new Date().toISOString(),updated_at:new Date().toISOString(),version:(editing?.version||0)+1};}else saved=await api('records',{method:editing?'PUT':'POST',body:JSON.stringify({...value,...(editing?{id:editing.id,version:editing.version}:{})})});setRecords(rs=>editing?rs.map(r=>r.id===saved.id?saved:r):[saved,...rs]);setCreateKind(null);setEditing(null);setSelected(saved);notify('Record saved.');}finally{setBusy(false);}};
 const newRecord=(k:Kind)=>{setError('');setEditing(null);setCreateKind(k);};
 const login=(event:FormEvent<HTMLFormElement>)=>{event.preventDefault();const data=new FormData(event.currentTarget);void doAction(async()=>{if(!config)return;const response=await fetch(config.url+'/auth/v1/token?grant_type=password',{method:'POST',headers:{apikey:config.key,'Content-Type':'application/json'},body:JSON.stringify({email:data.get('email'),password:data.get('password')})});const value=await response.json<any>();if(!response.ok)throw new Error('Sign-in failed. Check your email and password.');const s={access_token:value.access_token,refresh_token:value.refresh_token,expires_at:Math.floor(Date.now()/1000)+value.expires_in};sessionStorage.setItem('ahf-session',JSON.stringify(s));setMfaNeeded(!hasSecondFactor(s.access_token));setSession(s);});};
 const signout=()=>doAction(async()=>{const previous=session;authEpoch.current++;setSession(null);setProfile(null);setRecords([]);setNotices([]);setMfaNeeded(false);setSelected(null);setApprovals([]);setMembers([]);seenNotices.current=null;setError('');sessionStorage.removeItem('ahf-session');if(!config||!previous)return;try{const registration='serviceWorker'in navigator?await navigator.serviceWorker.getRegistration():undefined;const subscription=await registration?.pushManager?.getSubscription();if(subscription){const all=await api('push');const current=all.find((d:any)=>d.endpoint===subscription.endpoint);if(current)await api('push',{method:'DELETE',body:JSON.stringify({id:current.id})});await subscription.unsubscribe();}}catch{/* Account administrator can revoke remote registrations independently. */}try{const response=await fetch(config.url+'/auth/v1/logout?scope=local',{method:'POST',headers:{apikey:config.key,Authorization:`Bearer ${previous.access_token}`}});if(!response.ok)notify('Local session cleared. Remote revocation could not be confirmed.');}catch{notify('Local session cleared. Remote revocation could not be confirmed.');}});






 useEffect(()=>{if(!profile||demo)return;const previous=seenNotices.current;if(previous){const fresh=notices.filter(n=>!n.read_at&&!previous.has(n.id));if(fresh.length)notify(fresh.length===1?fresh[0].title:fresh.length+' new workspace updates');}seenNotices.current=new Set(notices.map(n=>n.id));},[notices,profile,demo,notify]);
 useEffect(()=>{if(!profile||demo)return;const timer=setInterval(()=>{if(document.visibilityState==='visible'&&navigator.onLine)api('notifications').then(setNotices).catch(e=>setError(e.message));},15000);return()=>clearInterval(timer);},[api,demo,profile]);
 useEffect(()=>{if(!profile)return;const params=new URLSearchParams(window.location.search),id=params.get('notification');if(id&&notices.length){const n=notices.find(n=>n.id===id);if(n){const record=visible.find(r=>r.id===n.record_id);if(record)setSelected(record);else setSection('Approvals');window.history.replaceState({},'',window.location.pathname);}}},[notices,visible,profile]);
 if(loading&&!profile)return <div className="loading-screen"><img src={organization.logo} alt="" width="54"/><h2>Opening your workspace</h2><LoaderCircle className="spin" size={22}/></div>;
 if(config?.mode==='setup')return <OrganizationSetup/>;
 if(config&&session&&mfaNeeded)return <MfaGate config={config} session={session} onVerified={s=>{sessionStorage.setItem('ahf-session',JSON.stringify(s));setMfaNeeded(false);setError('');setSession(s);}} onCancel={()=>void signout()}/>;
 if(!config)return <div className="auth-screen"><div className="auth-card"><img src={organization.logo} width="24" alt="AHF"/><h1>Your workspace is ready to connect.</h1><p>{error||'Configure the private Supabase project to enable staff sign-in. For a local walkthrough, explicitly enable demo mode.'}</p><div className="info-note">Setup instructions are included in README.md. This application does not open private records without a configured backend.</div></div></div>;
 if(!demo&&!profile)return <div className="auth-screen"><div className="auth-card"><img src={organization.logo} width="24" alt="AHF"/><p>Sign in with your authorized team account.</p>{error&&<div role="alert" className="error">{error}</div>}<form onSubmit={login}><label>Email address<input required name="email" type="email" autoComplete="username"/></label><label>Password<input required name="password" type="password" autoComplete="current-password"/></label><button className="button primary" disabled={busy}>{busy?'Signing in…':'Sign in'}<ArrowRight size={16}/></button></form><p className="fine">Need an account or a password reset? Contact the person managing AHF’s private backend.</p></div></div>;
 if(!profile)return null;
 const activeSection=sections.find(s=>s.name===section)!;

 const activePrograms=visible.filter(r=>r.kind==='program'&&r.status==='Active');
 return <div className="app-shell">
  <header className="topbar"><div className="brand"><button className="icon-button mobile-toggle" onClick={()=>setMenu(!menu)} aria-label="Toggle navigation"><Menu size={22}/></button><img src={organization.logo} className="official-header-logo" alt="Aminia Hope Foundation logo"/><div>Aminia Hope<span>FOUNDATION</span></div></div><div className="top-search"><Search size={17}/><input aria-label="Search workspace" placeholder="Search your workspace…" value={search} onChange={e=>setSearch(e.target.value)}/><span className="search-hint">Search</span>{search&&<div className="search-results"><p>Workspace results</p>{globalResults.length?globalResults.map(r=><button key={r.id} onClick={()=>{go(navFor(r.kind),r.kind);open(r);}}><span>{r.title}<small>{labels[r.kind]}</small></span><ChevronRight size={16}/></button>):<p>No matching records.</p>}</div>}</div><div className="top-actions">{!demo&&<button className="icon-button" disabled={loading} onClick={()=>void refresh()} aria-label="Refresh live records" title={lastSynced?'Last synced '+new Date(lastSynced).toLocaleTimeString():'Refresh records'}><RefreshCw size={17}/></button>}<span className="workspace-tag">{demo?'Demo workspace':'Team workspace'}</span><button className="icon-button bell" onClick={()=>setPanel('notifications')} aria-label="Open notifications"><Bell size={19}/>{notices.some(n=>!n.read_at)&&<i/>}</button><button className="account-button" onClick={()=>go('Settings')} aria-label="Open account settings"><span className="avatar">{profile.name.split(' ').map(s=>s[0]).join('').slice(0,2)}</span><ChevronDown size={14}/></button></div></header>
  {menu&&<button className="nav-backdrop" onClick={()=>setMenu(false)} aria-label="Close navigation"/>}
  <aside className={'sidebar '+(menu?'open':'')}><div className="workspace-selector"><span className="foundation-icon"><Leaf size={20}/></span><div><strong>AHF Workspace</strong><small>Working together for hope</small></div><ChevronDown size={14}/></div><nav aria-label="Main navigation"><p className="nav-label">WORKSPACE</p>{sections.slice(0,7).filter(s=>!s.kinds.length||s.kinds.some(k=>canRead(profile,k))).map(s=><button key={s.name} className={section===s.name?'active':''} onClick={()=>go(s.name)}><s.icon size={18}/>{s.name}{s.name==='Tasks'&&<span className="nav-count">{pendingTasks.filter(t=>t.assignee===profile.id).length}</span>}{s.name==='Finance'&&waiting.some(r=>r.kind==='expense')&&<i className="nav-dot"/>}</button>)}<p className="nav-label second">ORGANIZATION</p>{sections.slice(7).map(s=><button key={s.name} className={section===s.name?'active':''} onClick={()=>go(s.name)}><s.icon size={18}/>{s.name}</button>)}</nav><div className="sidebar-bottom"><div className="sidebar-footer"><ShieldCheck size={14}/>{demo?'Sample data only':'Private team workspace'}<span>v0.3</span></div></div></aside>
  <main className="main-content"><div className="content-wrap">
   {!online&&<div className="offline-banner"><WifiOff size={17}/>You’re offline. Reconnect before making changes.</div>}
   {demo&&<div className="demo-banner"><Sparkles size={15}/><span>Demo mode · Explore with sample records. Do not enter real personal information.</span><button onClick={()=>go('Settings')}>Setup guide<ArrowRight size={13}/></button></div>}
   {error&&<div className="error" role="alert">{error}<button onClick={()=>setError('')} aria-label="Dismiss error"><X size={16}/></button></div>}
   <div className="page-heading"><div><div className="breadcrumb">Workspace <ChevronRight size={12}/> {section}</div><h1>{section==='Overview'?'Overview':section==='Secretary'?'Secretary’s workspace':section==='Finance'?'Finance & accountability':section}</h1><p>{activeSection.description}</p></div><div className="heading-actions">{section==='Overview'?<><button className="button secondary date-button" onClick={()=>go('Secretary','meeting')}><CalendarDays size={16}/>{new Intl.DateTimeFormat('en-GB',{day:'numeric',month:'short',year:'numeric',timeZone:'Africa/Kampala'}).format(new Date())}</button><button className="button primary" onClick={()=>{go('Tasks');newRecord('task');}} disabled={!canWrite(profile,'task')}><Plus size={17}/>Create task</button></>:activeSection.kinds.length&&canWrite(profile,kind)?<button className="button primary" onClick={()=>newRecord(kind)}><Plus size={17}/>Add {singular[kind]}</button>:null}</div></div>
   {section==='Overview'&&<>
    <section className="welcome-card official-welcome"><div><div className="eyebrow"><span className="live-dot"/>PURPOSE INTO PROGRESS</div><h2>Small acts.<br/>Lasting hope.</h2><p>Welcome back, {profile.name.split(' ')[0]}. Here’s what’s<br className="desktop-break"/> happening across the foundation today.</p><button onClick={()=>go(canRead(profile,'program')?'Programs':'Approvals')}>{canRead(profile,'program')?'Explore your programmes':'Open your review inbox'}<ArrowRight size={16}/></button></div><img className="official-hero-logo" src={organization.logo} alt="Official Aminia Hope Foundation logo"/><span className="hero-chip">Building a Brighter Future</span></section>
    <div className="stats-grid">{canRead(profile,'donation')&&<Stat label="Contributions received" value={canRead(profile,'donation')?money(received):'Restricted'} note="Verified donations · UGX only" icon={ArrowDownLeft}/>}{canRead(profile,'program')&&<Stat label="Active programs" value={activePrograms.length} note="Programs currently in progress" icon={Heart}/>}<Stat label="Awaiting review" value={approvals.filter(a=>a.status==='Pending').length} note="Requests available in your Approvals inbox" icon={Clock}/><Stat label="My open actions" value={pendingTasks.filter(r=>r.assignee===profile.id).length} note="Tasks, activities, and resolutions" icon={CheckCircle2}/></div>
    <div className="dashboard-grid"><section className="card priority-card"><div className="card-heading"><div><h2>Needs your attention <span className="counter">{waiting.length}</span></h2><p>A few next steps to keep things moving.</p></div><button className="text-button" onClick={()=>go('Tasks')}>View tasks<ArrowRight size={14}/></button></div>{waiting.length?waiting.slice(0,4).map(r=><button className="attention-row" key={r.id} onClick={()=>open(r)}><span className={'record-icon '+(r.kind==='expense'?'gold':'purple')}>{r.kind==='expense'?<Wallet size={19}/>:<FileText size={19}/>}</span><span className="row-text"><strong>{r.title}</strong><small>{r.kind==='expense'?'Expense request':'Meeting minutes'} · {shortDate(r.date)}</small></span><Badge>{r.status}</Badge><ChevronRight size={16}/></button>):<Empty message="No submitted records are waiting in your workspace. Check Approvals for review requests."/>}<div className="card-bottom"><ShieldCheck size={15}/>A clear process builds a stronger foundation.</div></section>
    {canRead(profile,'account')&&<section className="card funding-card"><div className="card-heading"><div><h2>Resources at a glance</h2><p>Recorded contributions and spending</p></div><Wallet size={18}/></div>{canRead(profile,'donation')?<><strong className="funding-total">{money(received-paid)}</strong><span className="muted small">UGX donations less recorded payments · view ledger for balances</span><div className="resource-bars"><div><span>Received</span><div><i style={{width:'100%'}}/></div><b>{money(received)}</b></div><div><span>Paid out</span><div><i className="paid-bar" style={{width:Math.min(100,received?paid/received*100:0)+'%'}}/></div><b>{money(paid)}</b></div></div><button className="text-button" onClick={()=>go('Finance')}>Open financial records<ArrowRight size={14}/></button></>:<Empty message="Financial information is restricted to authorized roles."/>}</section>}
    {canRead(profile,'program')&&<section className="card programs-card"><div className="card-heading"><div><h2>Our programs</h2><p>Where your team is making a difference.</p></div><button className="text-button" onClick={()=>go('Programs')}>View all<ArrowRight size={14}/></button></div><div className="program-list">{activePrograms.length?activePrograms.slice(0,3).map((r,i)=><button key={r.id} className="program-mini" onClick={()=>open(r)}><span className={'program-illustration illustration-'+i}>{i===0?<FileText size={26}/>:i===1?<Users size={26}/>:<Heart size={26}/>}<span className="illustration-circle"/></span><span className="program-mini-body"><small>{r.category}</small><strong>{r.title}</strong><span className="program-footer"><Badge>{r.status}</Badge><ArrowUpRight size={16}/></span></span></button>):<Empty/>}</div></section>}
    <section className="card activity-card"><div className="card-heading"><div><h2>Recent updates</h2><p>The latest from your workspace.</p></div><Activity size={18}/></div><div className="timeline">{visible.slice().sort((a,b)=>b.updated_at.localeCompare(a.updated_at)).slice(0,4).map(r=><button key={r.id} onClick={()=>open(r)}><span className="timeline-dot"/><span><strong>{r.title}</strong><small>{labels[r.kind]} · {shortDate(r.updated_at)}</small></span></button>)}</div></section></div>
   </>}
   {activeSection.kinds.length>0&&<>
    {section==='Secretary'&&<div className="secretary-intro"><span className="record-icon purple"><ClipboardList size={24}/></span><div><h3>Every decision deserves a clear next step.</h3><p>Prepare meetings, maintain official records, and follow through on the team’s commitments.</p></div><span className="mini-label">GOVERNANCE & RECORDS</span></div>}
    {section==='Beneficiaries'&&<div className="info-note"><ShieldCheck size={18}/><span>Use case references and the minimum information needed. This first version is a basic support register; detailed safeguarding casework needs a dedicated restricted workflow.</span></div>}
    {section==='Finance'&&canRead(profile,'account')&&<FinanceSummary records={visible} api={api} demo={demo} onError={setError}/>}
    {section==='Donors'&&<DonorSummary records={visible} onOpen={open}/>}
    {section==='Programs'&&<div className="info-note">Programme records link activities, indicators, tasks, and budgets. Assign programme members from each programme’s detail view. Indicator figures retain their unit, evidence, and counting method.</div>}
    <ModuleRecords key={section} kinds={activeSection.kinds} kind={kind} onKind={k=>{setKind(k);setStatus('All statuses');setSearch('');}} rows={visible} profile={profile} team={team} search={search} onSearch={setSearch} status={status} onStatus={setStatus} onOpen={open}/>
   </>}
   {section==='Approvals'&&<Approvals rows={approvals} profile={profile} api={api} demo={demo} onRefresh={refresh} onError={setError}/>}
   {section==='Team'&&<><div className="info-note"><Users size={18}/><span>Each person uses their own account. Roles follow responsibilities. Account invitations, role changes, and deactivation are managed in your private backend for this version.</span></div><div className="team-grid">{team.map((p,i)=><section key={p.id} className="card team-card"><span className={'avatar large color-'+i}>{p.name.split(' ').map(n=>n[0]).join('').slice(0,2)}</span><h2>{p.name}</h2><p>{p.roles.map(r=>roleLabels[r]).join(' & ')}</p><Badge>Active</Badge><div className="team-card-bottom"><span>{records.filter(r=>r.assignee===p.id&&!['Completed','Closed'].includes(r.status)&&canRead(profile,r.kind)).length} visible open assignments</span>{p.id===profile.id&&<b>You</b>}</div></section>)}</div></>}
   {section==='Reports'&&<Reports records={visible} profile={profile} team={team} api={api} demo={demo} onError={setError}/>}
   {section==='Settings'&&<div className="settings-grid"><section className="card settings-card"><div className="card-heading"><div><h2>Your account</h2><p>One account across your devices.</p></div><ShieldCheck size={19}/></div><div className="account-detail"><span className="avatar large">{profile.name.split(' ').map(n=>n[0]).join('').slice(0,2)}</span><div><strong>{profile.name}</strong><p>{profile.roles.map(r=>roleLabels[r]).join(' & ')}</p></div></div>{demo?<label>Preview another team role<select value={profile.id} onChange={e=>{setProfile(demoProfiles.find(p=>p.id===e.target.value)!);setSelected(null);go('Overview');}}>{demoProfiles.map(p=><option key={p.id} value={p.id}>{p.name} · {p.roles.map(r=>roleLabels[r]).join(' / ')}</option>)}</select></label>:<button className="button secondary" disabled={busy} onClick={()=>void signout()}><LogOut size={16}/>Sign out & remove this device registration</button>}<p className="fine">Leadership roles do not automatically include beneficiary case access.</p></section>
    <section className="card settings-card"><div className="card-heading"><div><h2>Install AHF Workspace</h2><p>Open your workspace like an app.</p></div><Smartphone size={20}/></div><p>Use the same workspace on your phone, tablet, and laptop. Your records stay connected through the private backend.</p><button className="button primary" onClick={install}><Download size={16}/>Install / view instructions</button><p className="fine">An internet connection is required for private records and approvals.</p></section>
    <NotificationSettings api={api} demo={demo} vapidPublic={config.vapidPublic} pushReady={config.pushReady} onMessage={notify}/>
    <section className="card settings-card setup-checklist"><div className="organization-settings"><img src={organization.logo} alt="Official Aminia Hope Foundation logo"/><h2>{organization.name}</h2><p>{organization.tagline}</p><span className="badge amber">{organization.registrationStatus}</span><p className="fine">Wakiso, Uganda · Official contact details not yet confirmed</p>{!demo&&canWrite(profile,'program')&&<button className="button secondary" disabled={busy} onClick={()=>void doAction(async()=>{const created:RecordItem[]=await api('organization',{method:'POST'});setRecords(current=>[...created,...current.filter(r=>!created.some(n=>n.id===r.id))]);notify(created.length?created.length+' proposed programme areas added.':'All proposed programme areas are already present.');})}><Plus size={15}/>Add proposed programme areas</button>}<p className="fine">Sourced from the draft constitution. Added as planned, never as active delivery.</p></div><div className="card-heading"><div><h2>{demo?'Before your team goes live':'Workspace configuration'}</h2><p>A practical handover checklist.</p></div><Settings size={19}/></div>{['Create the private Supabase project and apply the SQL migration.','Provision staff accounts and their approved roles.','Configure Cloudflare runtime variables and VAPID secrets.','Test access rules, approvals, backups, and push on real devices.','Disable demo mode before entering real records.'].map((s,i)=><div className="setup-step" key={s}><span>{i+1}</span><p>{s}</p></div>)}<p className="fine">Full deployment instructions are in the source package. The current build includes a basic case register, not advanced safeguarding or statutory accounting workflows.</p>{demo&&<button className="button secondary" onClick={()=>setPanel('reset')}><RefreshCw size={16}/>Reset demo records</button>}</section></div>}
   <footer className="page-footer"><span><Leaf size={13}/>Aminia Hope Foundation</span><span>Empowering People · Strengthening Communities</span></footer>
  </div></main>
  {toast&&<div className="toast" role="status"><CheckCircle2 size={18}/>{toast}</div>}
  {createKind&&<Modal title={(editing?'Edit ':'Add ')+singular[createKind]} onClose={()=>{if(!busy){setCreateKind(null);setEditing(null);}}} wide><RecordForm key={editing?.id||createKind} kind={createKind} item={editing} records={visible} team={team} profile={profile} busy={busy||!online} onSave={saveValue} onCancel={()=>{setCreateKind(null);setEditing(null);}}/></Modal>}
  {selected&&!createKind&&<Modal title={selected.title} onClose={()=>setSelected(null)} wide>{error&&<div className="error" role="alert">{error}</div>}<RecordDetail key={selected.id} item={selected} records={visible} profile={profile} team={team} members={members} api={api} demo={demo} busy={busy||!online} onEdit={()=>{setEditing(selected);setCreateKind(selected.kind);}} onStatus={(s,n)=>void changeStatus(selected,s,n)} onOpen={open} onRefresh={refresh} onError={setError}/></Modal>}
  {panel==='notifications'&&<Modal title="Your notifications" onClose={()=>setPanel(null)}><div className="detail-content">{notices.length?<><button className="text-button" onClick={()=>void doAction(async()=>{await api('notifications',{method:'PATCH'});setNotices(ns=>ns.map(n=>({...n,read_at:new Date().toISOString()})));})}>Mark all as read<Check size={14}/></button>{notices.map(n=><button key={n.id} className="notice-row" onClick={()=>{const r=visible.find(r=>r.id===n.record_id);if(r){setPanel(null);go(navFor(r.kind),r.kind);open(r);}else{setPanel(null);go('Approvals');}}}><Bell size={18}/><span><strong>{n.title}</strong><p>{n.body}</p><small>{shortDate(n.created_at)}</small></span>{!n.read_at&&<i className="nav-dot"/>}</button>)}</>:<Empty message={demo?'Live notifications will appear here after connecting the backend. Review requests are already visible on the demo dashboard.':'You’re all caught up.'}/>}</div></Modal>}
  {panel==='install'&&<Modal title="Install AHF Workspace" onClose={()=>setPanel(null)}><div className="detail-content install-instructions"><Smartphone size={36}/><h3>Your workspace, one tap away.</h3><p><strong>iPhone / iPad:</strong> Open this address in Safari, tap Share, then Add to Home Screen. Open the installed app and enable notifications in Settings.</p><p><strong>Android:</strong> Open in Chrome, then choose Install app or Add to Home screen from the browser menu.</p><p><strong>Laptop:</strong> Open in Chrome or Edge and use the install icon in the address bar or browser menu.</p><div className="info-note">Installation requires HTTPS or localhost. iPhone/iPad push requires iOS/iPadOS 16.4 or later. Private records require an internet connection.</div></div></Modal>}
  {panel==='reset'&&<Modal title="Reset sample records?" onClose={()=>setPanel(null)}><div className="detail-content"><p>This removes your demo edits from this browser and restores the sample workspace.</p><div className="form-actions"><button className="button secondary" onClick={()=>setPanel(null)}>Cancel</button><button className="button primary" onClick={()=>{setRecords(seedRecords());setPanel(null);notify('Demo records restored.');}}>Reset demo</button></div></div></Modal>}
 </div>;
}
